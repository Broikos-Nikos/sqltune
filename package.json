{
  "name": "sqltune",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:shop": "tsx tools/build-shop.ts",
    "build:dataset": "tsx tools/build-dataset.ts",
    "score": "tsx tools/score.ts",
    "check": "npm run check:source && npm run check:licence && npm run check:measure && npm run check:claims",
    "check:source": "tsx tools/check-source.ts",
    "check:licence": "tsx tools/check-licence.ts",
    "check:measure": "tsx tools/check-measure.ts",
    "check:claims": "tsx tools/check-claims.ts",
    "check:page": "tsx tools/check-page.ts",
    "check:capture": "tsx tools/check-capture.ts",
    "capture": "tsx tools/capture.ts",
    "verify": "tsx tools/verify.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": true
  },
  "engines": {
    "node": "24.18.0"
  }
}
